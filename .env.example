# Postgres
POSTGRES_USER=harpocrate
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=harpocrate

# Harpocrate backend
HARPOCRATE_KEYCLOAK_URL=https://keycloak.yoops.org
HARPOCRATE_KEYCLOAK_REALM=yoops
HARPOCRATE_KEYCLOAK_CLIENT_ID=harpocrate-vault
# Generer avec : py -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
HARPOCRATE_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES
HARPOCRATE_PUBLIC_URL=http://localhost:8000
HARPOCRATE_LOG_LEVEL=INFO

# Auth locale (alternative a Keycloak OIDC)
# WARNING : stocke un mot de passe en clair — ce fichier doit etre en chmod 600.
# Activer uniquement pour dev / break-glass (jamais en prod sans audit prealable).
HARPOCRATE_ADMIN_LOCAL_ENABLED=false
HARPOCRATE_ADMIN_LOCAL_USERNAME=admin
HARPOCRATE_ADMIN_LOCAL_PASSWORD=
HARPOCRATE_ADMIN_LOCAL_EMAIL=admin@harpocrate.local
HARPOCRATE_ADMIN_LOCAL_DISPLAY_NAME=Local Admin

# Notifications via listmonk (LOT_57) — provider d'envoi de mails.
# LEGACY — la connexion se règle dans l'UI d'admin (« Paramétrage Listmonk ») ;
# le token y est stocké chiffré. Ces trois variables ne servent plus qu'à une
# reprise UNIQUE vers la base au premier démarrage qui les voit, si aucune
# connexion n'y est encore réglée. Laisser vide sur une nouvelle instance.
HARPOCRATE_LISTMONK_URL=
HARPOCRATE_LISTMONK_USER=
HARPOCRATE_LISTMONK_TOKEN=
# LEGACY — les ID de templates listmonk se paramètrent dans l'UI d'admin
# (« Paramétrage Listmonk », un ID par culture activée). Ces deux variables ne
# servent plus qu'à une reprise UNIQUE vers la base au premier démarrage qui
# les voit ; ensuite elles sont ignorées. Laisser vide sur une nouvelle instance.
HARPOCRATE_LISTMONK_TEMPLATE_RECOVERY_FR=
HARPOCRATE_LISTMONK_TEMPLATE_RECOVERY_EN=

# Recovery passphrase — tuning du flow (defaults raisonnables, optionnel)
HARPOCRATE_RECOVERY_SESSION_TTL_MINUTES=30
HARPOCRATE_RECOVERY_MAX_ATTEMPTS=3
HARPOCRATE_RECOVERY_ANOMALY_THRESHOLD=5
HARPOCRATE_RECOVERY_ANOMALY_WINDOW_HOURS=24

# Réplication — appairage inter-instances (LOT 5)
# DEV-ONLY. Désactive la vérification TLS pour les calls inter-instances du
# pairing v2 (le standby contacte le master en HTTPS sur /pairing/confirm-v2).
# En prod, utilise un certificat public valide (Cloudflare Tunnel,
# Let's Encrypt) et laisse cette variable à false : la vérification TLS
# protège le token d'appairage contre un MITM réseau entre les deux
# instances. La valeur par défaut ci-dessous (true) est uniquement adaptée
# au dev local avec des certs auto-signés — repasser à false en prod.
HARPOCRATE_REPLICATION_INSECURE_SKIP_TLS_VERIFY=true

# Pairing exec — wizard d'appairage en mode "natif" (sans socket Docker monté)
# Pour exécuter les 7 étapes du wizard via une session SSH unique vers la
# machine hôte de Postgres. Laisser vide pour désactiver le mode natif :
# le wizard ne sera utilisable QUE si /var/run/docker.sock est monté dans le
# conteneur backend (mode docker_compose_auto auto-détecté).
#
# Si l'admin veut activer le mode natif :
#   - Renseigner ici l'IP/hostname SSHable de la machine qui héberge Postgres
#     (ex: 192.168.10.198, host.docker.internal si extra_hosts configuré)
#   - L'admin saisira ensuite username + password/clé dans l'UI pour chaque
#     session de pairing — aucun credential n'est stocké côté serveur.
HARPOCRATE_SELF_SSH_HOST=
HARPOCRATE_SELF_SSH_PORT=22

# Observabilité — collecteurs Alloy (docker-compose.yml, profil `observability`).
# scripts/refresh.sh démarre les deux collecteurs et ajoute ces clés au .env
# du serveur si elles manquent (sans jamais modifier une valeur présente).
# Aucune n'est un secret. Défauts : stack Loki/VictoriaMetrics du portail,
# celle qu'interroge l'outil MCP `logs_query`.
LOKI_URL=http://192.168.10.164:3100/loki/api/v1/push
METRICS_URL=http://192.168.10.164:8428/api/v1/write
# Label `host` des journaux et métriques ; refresh.sh y met `hostname`.
ALLOY_HOSTNAME=
# Label `role` (bornes : portail / workspace / test / prod).
ALLOY_ROLE=prod
