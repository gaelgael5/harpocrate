// Grafana Alloy — collecteur logs journald uniquement
// Module : harpocrate
// Variante sans Docker : pour les LXC sans Docker installé.
// Pousse vers la stack Loki centrale (LXC 116, agflow-logs).

logging {
  level  = "info"
  format = "logfmt"
}

// ── Collecte journald ─────────────────────────────────────────────────────────

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
}

loki.source.journal "system" {
  path          = "/run/log/journal"
  forward_to    = [loki.write.central.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels        = {
    host   = env("HOSTNAME"),
    module = "harpocrate",
  }
}

// ── Sortie Loki centrale ──────────────────────────────────────────────────────

loki.write "central" {
  endpoint {
    url = env("LOKI_URL")
  }
}
