# Postgres
POSTGRES_USER=harpocrate
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=harpocrate

# Harpocrate backend
HARPOCRATE_KEYCLOAK_URL=https://keycloak.yoops.org
HARPOCRATE_KEYCLOAK_REALM=yoops
HARPOCRATE_KEYCLOAK_CLIENT_ID=harpocrate-vault
# Generer avec : py -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
HARPOCRATE_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES
HARPOCRATE_PUBLIC_URL=http://localhost:8000
HARPOCRATE_LOG_LEVEL=INFO

# Auth locale (alternative a Keycloak OIDC)
# WARNING : stocke un mot de passe en clair — ce fichier doit etre en chmod 600.
# Activer uniquement pour dev / break-glass (jamais en prod sans audit prealable).
HARPOCRATE_ADMIN_LOCAL_ENABLED=false
HARPOCRATE_ADMIN_LOCAL_USERNAME=admin
HARPOCRATE_ADMIN_LOCAL_PASSWORD=
HARPOCRATE_ADMIN_LOCAL_EMAIL=admin@harpocrate.local
HARPOCRATE_ADMIN_LOCAL_DISPLAY_NAME=Local Admin

# Notifications via listmonk (LOT_57) — provider d'envoi de mails.
# Si HARPOCRATE_LISTMONK_URL/USER/TOKEN sont vides, le service retombe en
# no-op silencieux (log "listmonk_not_configured") — l'UI recovery reste
# fonctionnelle mais aucun mail ne part.
HARPOCRATE_LISTMONK_URL=
HARPOCRATE_LISTMONK_USER=
HARPOCRATE_LISTMONK_TOKEN=
# IDs des templates transactional listmonk pour les mails de recovery,
# par locale. À configurer côté admin listmonk avant le premier envoi.
HARPOCRATE_LISTMONK_TEMPLATE_RECOVERY_FR=4
HARPOCRATE_LISTMONK_TEMPLATE_RECOVERY_EN=5

# Recovery passphrase — tuning du flow (defaults raisonnables, optionnel)
HARPOCRATE_RECOVERY_SESSION_TTL_MINUTES=30
HARPOCRATE_RECOVERY_MAX_ATTEMPTS=3
HARPOCRATE_RECOVERY_ANOMALY_THRESHOLD=5
HARPOCRATE_RECOVERY_ANOMALY_WINDOW_HOURS=24

# Réplication — appairage inter-instances (LOT 5)
# DEV-ONLY — JAMAIS en prod. Autorise le standby à joindre un master servi
# par un certificat TLS auto-signé lors de l'appairage v2. En prod, configure
# un certificat public valide (Cloudflare Tunnel, Let's Encrypt) et laisse
# cette variable à false. Activer en dev permet de tester le flow d'appairage
# sans avoir à provisionner une PKI.
HARPOCRATE_REPLICATION_PAIRING_ALLOW_SELF_SIGNED=false
